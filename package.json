  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build && bash scripts/copy-standalone-assets.sh",
    "start": "next start -H 0.0.0.0 -p ${PORT:-3000}",
    "lint": "tsc --noEmit",
    "postinstall": "prisma generate",
