# =============================================================================
# CloudContent TR — environment variables
# Copy:  cp .env.example .env
# Production: configure in Azure App Service → Configuration → Application settings
# =============================================================================

# -----------------------------------------------------------------------------
# Database (PostgreSQL) — REQUIRED
# -----------------------------------------------------------------------------
# Local macOS example:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudcontent_tr?schema=public"
#
# Azure Database for PostgreSQL Flexible Server example:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST.postgres.database.azure.com:5432/cloudcontent_tr?schema=public&sslmode=require"
#
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/cloudcontent_tr?schema=public"

# -----------------------------------------------------------------------------
# Encryption (server-only) — REQUIRED in production
# -----------------------------------------------------------------------------
# Encrypts API keys saved in Settings (Azure OpenAI, Blob, Zapier, etc.). Min 16 chars.
# Never use NEXT_PUBLIC_ prefix. Rotate only with a re-encryption plan.
SETTINGS_ENCRYPTION_KEY="change-me-to-a-long-random-secret-key-at-least-16-chars"

# -----------------------------------------------------------------------------
# App URLs — REQUIRED in production
# -----------------------------------------------------------------------------
# APP_URL: OAuth callbacks, internal links
# APP_PUBLIC_URL: public image URLs for Zapier / Instagram (must be HTTPS, not localhost)
APP_URL="http://localhost:3000"
APP_PUBLIC_URL="https://your-app.azurewebsites.net"
# NEXT_PUBLIC_APP_URL="https://your-app.azurewebsites.net"

# -----------------------------------------------------------------------------
# Node / Azure App Service
# -----------------------------------------------------------------------------
NODE_ENV="development"
# PORT is set automatically on Azure App Service (usually 8080). Do not hardcode in production.
# WEBSITE_SITE_NAME is set by Azure — used to detect App Service runtime.

# -----------------------------------------------------------------------------
# Document file storage
# -----------------------------------------------------------------------------
# local = disk under LOCAL_UPLOAD_DIR (development only)
# azure = Azure Blob (required in production)
STORAGE_PROVIDER="local"
LOCAL_UPLOAD_DIR="storage/uploads"

# -----------------------------------------------------------------------------
# Instagram / social images storage
# -----------------------------------------------------------------------------
# local = development disk | azure = Azure Blob (required in production)
SOCIAL_IMAGE_STORAGE_PROVIDER="local"
LOCAL_SOCIAL_IMAGE_DIR="storage/social-images"

# -----------------------------------------------------------------------------
# Azure Blob Storage — REQUIRED in production
# -----------------------------------------------------------------------------
# Instagram images container (default in Settings UI: instagram-assets)
AZURE_STORAGE_CONNECTION_STRING=""
AZURE_BLOB_CONTAINER_NAME="instagram-assets"
# AZURE_STORAGE_CONTAINER_NAME="instagram-assets"
AZURE_STORAGE_PUBLIC_BASE_URL=""
# Document uploads container (PDF/DOCX/PPTX)
AZURE_DOCUMENTS_CONTAINER_NAME="documents"
AZURE_BLOB_UPLOAD_MAX_RETRIES="3"

# Production recommended:
# STORAGE_PROVIDER="azure"
# SOCIAL_IMAGE_STORAGE_PROVIDER="azure"

# -----------------------------------------------------------------------------
# Meta / Instagram Graph API (optional)
# -----------------------------------------------------------------------------
META_APP_ID=""
META_APP_SECRET=""
META_GRAPH_API_VERSION="v21.0"
# META_OAUTH_REDIRECT_URI="https://your-app.azurewebsites.net/api/instagram/oauth/callback"

# -----------------------------------------------------------------------------
# Zapier (optional — prefer Settings UI with encrypted DB storage)
# -----------------------------------------------------------------------------
# ZAPIER_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/..."

# -----------------------------------------------------------------------------
# OpenAI Images (optional — prefer Settings UI)
# -----------------------------------------------------------------------------
# OPENAI_API_KEY=""

# -----------------------------------------------------------------------------
# Azure OpenAI / Document Intelligence (optional — prefer Settings UI)
# -----------------------------------------------------------------------------
# Configured via /settings in the admin panel after SETTINGS_ENCRYPTION_KEY is set.

# -----------------------------------------------------------------------------
# Auth note (NextAuth)
# -----------------------------------------------------------------------------
# This application does NOT use NextAuth.js today. There is no login gate on admin routes.
# Do not set NEXTAUTH_SECRET / NEXTAUTH_URL unless you add authentication later.
# For production, consider Azure App Service Authentication (Easy Auth) or a future auth layer.

# -----------------------------------------------------------------------------
# Optional production enforcement
# -----------------------------------------------------------------------------
# FORCE_AZURE_STORAGE_CHECK="true"
